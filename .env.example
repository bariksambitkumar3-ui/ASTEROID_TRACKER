# ==============================================================================
# ASTRA – 3D Solar System & Asteroid Explorer Environment Configuration
# ==============================================================================

# 1. NASA Near-Earth Object Web Service (NeoWs) API
# ------------------------------------------------------------------------------
# Freely available at: https://api.nasa.gov/
# Simply enter your name and email to get a free personal API key instantly.
# A personal key provides 1,000 requests per hour.
# If left as 'DEMO_KEY', NASA's public demo key is used (30 requests/hour).
VITE_NASA_API_KEY=DEMO_KEY

# 2. Weather API (Earth Weather)
# ------------------------------------------------------------------------------
# Free signup at: https://openweathermap.org/api
# Free tier provides 1,000 API calls/day.
# NOTE: If left blank, ASTRA automatically uses Open-Meteo (100% free, no key needed!).
VITE_OPENWEATHER_API_KEY=

# 3. Default City for Earth Weather (e.g. Pune, IN / New York, US / London, UK)
VITE_WEATHER_DEFAULT_CITY=Pune, IN
